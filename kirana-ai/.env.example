# Copy to .env and fill in your key:  cp .env.example .env
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults shown)
DATABASE_URL=postgresql+psycopg://kirana_ai:kirana_ai@localhost:5432/kirana
# Print every SQL statement the ORM runs
SQL_ECHO=false
QDRANT_URL=http://localhost:6335
COLLECTION_NAME=kirana_kb
TENANT_ID=kirana
LLM_PROVIDER=gemini
GENERATION_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Hybrid = dense + BM25 fused with RRF. Set false for dense only.
HYBRID_SEARCH=true
# Earlier turns resent to the model each turn; 0 = history off
HISTORY_TURNS=10
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
